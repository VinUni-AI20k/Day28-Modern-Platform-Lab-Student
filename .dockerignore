# Keep the build context small: the API image copies only pyproject.toml,
# README.md and src/, and the Feast image copies nothing at all. Shipping the
# local virtualenv would add ~0.8 GB to the context and to the BuildKit cache
# on every build, and would invalidate layers whenever a host-only file changes.
.venv/
.git/
.github/
.lab28/
evidence/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
